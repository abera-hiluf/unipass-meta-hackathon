APP_NAME=UniPass AI + AgentX
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://your-user:your-password@your-host:5432/your-database

# Keyed HMAC secret for document identifier hashing (never commit production secrets)
DOCUMENT_HMAC_SECRET=replace-with-a-secure-random-secret

# JWT Authentication (generate a secure random string for production)
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Reserved for a later Meta Model API integration. Never commit real values.
# META_API_KEY=
# META_MODEL=
