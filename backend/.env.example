APP_NAME=UniPass AI + AgentX
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://your-user:your-password@your-host:5432/your-database

# Keyed HMAC secret for document identifier hashing (never commit production secrets)
DOCUMENT_HMAC_SECRET=replace-with-a-secure-random-secret

# JWT Authentication (generate a secure random string for production)
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_PROVIDER=none
# To enable real email delivery, set EMAIL_PROVIDER=smtp and configure a real
# SMTP server. Keep SMTP_PASSWORD out of source control.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Private identity-document storage. Local storage is for development only.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=.local_storage
DOCUMENT_MAX_UPLOAD_BYTES=5242880
DOCUMENT_ANALYSIS_PROVIDER=none
SELFIE_MAX_UPLOAD_BYTES=2097152
SELFIE_RETENTION_DAYS=30
LIVENESS_MAX_UPLOAD_BYTES=10485760
LIVENESS_CHALLENGE_TTL_SECONDS=120
FACE_MATCH_THRESHOLD=0.8

# Opt-in Meta document analysis. Never commit real values.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL=sam-3.1
META_VISION_MODEL=muse-spark-1.3
META_API_TIMEOUT_SECONDS=20
